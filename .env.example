# 실제 값은 서버의 .env에만 작성
DB_PASSWORD=

# 32바이트 이상의 임의 문자열
EVALHUB_JWT_SECRET=

# 최초 관리자 생성용
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 인증서 관리 연락처
CERT_EMAIL=

# Base64로 인코딩한 임의의 32바이트 키
EVALHUB_MAIL_ENCRYPTION_KEY=

# Gmail 설정 완료 후 true로 변경
EVALHUB_MAIL_ENABLED=false
EVALHUB_GMAIL_CLIENT_ID=
EVALHUB_GMAIL_CLIENT_SECRET=
EVALHUB_GMAIL_REFRESH_TOKEN=
EVALHUB_MAIL_SENDER=